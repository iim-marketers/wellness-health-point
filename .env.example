NEXT_PUBLIC_SITE_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — bypasses RLS, must never be NEXT_PUBLIC_ prefixed.
SUPABASE_SECRET_KEY=

# Clinic booking notifications (SMTP).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# authenticated mailbox; "Wellness Clinic <bookings@example.com>" also works.
SMTP_FROM=
# Where new bookings land. Comma-separate for more than one recipient.
CLINIC_NOTIFICATION_EMAIL=

# Search Console ownership. Paste only the content value of the meta tag
# Google gives you, not the whole tag. Server-only — never NEXT_PUBLIC_.
GOOGLE_SITE_VERIFICATION=

# Clinic details. Blank falls back to the defaults in src/lib/site.ts.
NEXT_PUBLIC_CLINIC_NAME=
NEXT_PUBLIC_CLINIC_PHONE_PRIMARY=
NEXT_PUBLIC_CLINIC_PHONE_SECONDARY=
NEXT_PUBLIC_CLINIC_EMAIL=
NEXT_PUBLIC_CLINIC_ADDRESS=
NEXT_PUBLIC_CLINIC_HOURS=

# The same address and hours in parts, for schema.org structured data.
NEXT_PUBLIC_CLINIC_STREET=
NEXT_PUBLIC_CLINIC_LOCALITY=
NEXT_PUBLIC_CLINIC_REGION=
NEXT_PUBLIC_CLINIC_COUNTRY=
NEXT_PUBLIC_CLINIC_POSTAL_CODE=
# 24-hour times.
NEXT_PUBLIC_CLINIC_OPENS=
NEXT_PUBLIC_CLINIC_CLOSES=
# Set both or neither — coordinates are published only as a pair.
NEXT_PUBLIC_CLINIC_LATITUDE=
NEXT_PUBLIC_CLINIC_LONGITUDE=

# Social profiles and map.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_MAP_EMBED_URL=
